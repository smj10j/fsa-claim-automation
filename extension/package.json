{
  "name": "fsa-claim-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension to automate FSA claim submissions from Amazon purchases to Navia Benefits",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
